# Razorpay TEST-MODE credentials (Dashboard -> Settings -> API Keys, test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Anthropic API key (used only by agent/explain.py to draft explanations; never for decisions)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional overrides (defaults shown)
COUNTERFACT_SEED=42
COUNTERFACT_SIM_VARIANT=calibrated
COUNTERFACT_EXECUTOR=mock            # mock | razorpay
COUNTERFACT_EXECUTOR_FAILURE_RATE=0  # injected transient 5xx rate for MockExecutor
